# Keep the Docker build context small (and out of the image).
.git
.github
.claude
.venv
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local databases and generated artifacts
# (the runtime /data dir is created inside the image via `mkdir`, not copied —
#  do NOT add `/data/` here or it would exclude the data/ SOURCE package.)
*.db
chainwatch.db
chainwatch_vectors.db
site/
*.pdf

# Docs sources and tests are not needed in the runtime image
docs/
tests/
mkdocs.yml

# Secrets / local env
.env
.secrets/

# Model / HF caches if present
.cache/
*.safetensors
*.bin
