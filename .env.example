# ── Google AI Studio ──────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Gemini model to use (gemini-2.0-flash recommended for cost/speed balance)
GEMINI_MODEL=gemini-2.0-flash

# ── Data Sources ──────────────────────────────────────────────────────────────
# NewsAPI: https://newsapi.org (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# GDELT: no key required (free public API)
# NOAA: no key required (free public API)

# ── Alerting ──────────────────────────────────────────────────────────────────
# Slack webhook: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Gmail API (OAuth2 credentials from Google Cloud Console)
# Download credentials.json from: https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_SENDER_EMAIL=your_email@gmail.com
ALERT_EMAIL_RECIPIENT=recipient@example.com

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev (default), PostgreSQL for prod
DATABASE_URL=sqlite:///./chainwatch.db
# DATABASE_URL=postgresql://user:password@localhost:5432/chainwatch

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Scheduler: how often the Signal Monitor runs (minutes)
SCAN_INTERVAL_MINUTES=30

# Risk threshold for HIGH alert (1-10)
HIGH_RISK_THRESHOLD=7

# Alert cooldown: hours before re-alerting on same supplier+category
ALERT_COOLDOWN_HOURS=24

# ── Observability — Arize Phoenix (self-hosted, free) ─────────────────────────
# Off by default. When true, all Gemini calls are traced (prompt, response,
# latency, token counts) and one parent span groups each /scan run.
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=chainwatch
# Point at a running Phoenix collector (local: run `phoenix serve` → :6006).
# Leave unset to use the SDK default endpoint.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ── Web research — Tavily (Phase 1) ───────────────────────────────────────────
# Off by default. Without TAVILY_API_KEY every Tavily call is a safe no-op.
# Get a key (free tier ~1000 credits/mo): https://tavily.com
TAVILY_ENABLED=false
TAVILY_API_KEY=your_tavily_key_here
TAVILY_MAX_EXTRACT_URLS=10       # max URLs per batched extract (cost cap)
TAVILY_EXTRACT_CHARS=1500        # truncate extracted body to N chars
TAVILY_SEARCH_MAX_RESULTS=3      # results per brief-augmentation search
TAVILY_RISK_SEARCH=false         # per-supplier deep search in risk scorer (heaviest)
TAVILY_RISK_SEARCH_MAX_SUPPLIERS=3  # cap: only first N suppliers/batch get a search
TAVILY_MEDIUM_LOW=4              # lower bound of the MEDIUM band for elevation
TAVILY_MEDIUM_ELEVATE_MIN=2     # corroborating sources needed to elevate +1
TAVILY_MEDIUM_MAX_CHECKS=5      # max corroboration searches per event
# Optional Layer-2 prompt-injection scan (needs Ollama, arrives Phase 3):
INJECTION_MODEL_SCAN=false

# ── RAG retrieval (Phase 2) ───────────────────────────────────────────────────
# Off by default. When true, events/briefs/KB are embedded + retrieved to ground
# the impact analyst, risk scorer, and dashboard chat. Backfill existing data:
#   RAG_ENABLED=true python -m scripts.backfill_index
RAG_ENABLED=false
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
VECTOR_DB_PATH=./chainwatch_vectors.db

# ── RAG-Fusion + reranking (Phase 3) ──────────────────────────────────────────
# Fusion = multi-query expansion + Reciprocal Rank Fusion. Rerank reorders the
# fused pool. Both off by default (retrieve_best == plain vector search then).
FUSION_ENABLED=false
FUSION_SUBQUERIES=3
RERANK_ENABLED=false
RERANK_STRATEGY=crossencoder     # crossencoder | gemma | none
CROSSENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Self-hosted Gemma via Ollama (rerank strategy=gemma, and the Phase 4 judge):
GEMMA_MODEL=gemma3:4b
# OLLAMA_HOST=http://localhost:11434

# ── Evals + second-opinion judge (Phase 4) ────────────────────────────────────
# When true, a local Gemma model audits HIGH-risk briefs for faithfulness and
# triggers one regeneration if a brief is flagged. Needs Ollama + GEMMA_MODEL.
JUDGE_ENABLED=false
# Offline Ragas eval (uv sync --group evals; python -m evals.run_ragas) uses the
# Gemini judge + Google embeddings — no extra env beyond GOOGLE_API_KEY.
